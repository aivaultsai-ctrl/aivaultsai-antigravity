generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum CallIntent {
  LEAD
  FAQ
  FINANCIAL
  SPAM
}

enum CallMode {
  SALES
  DEFENSIVE
}

enum CallPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Tenant {
  id                String     @id @default(cuid())
  name              String
  notificationPhone String?
  preferWhatsApp    Boolean    @default(false)
  aiProfile         AIProfile?
  calls             Call[]
}

model AIProfile {
  id           String @id @default(cuid())
  tenantId     String @unique
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  systemPrompt String @default("Je bent een behulpzame assistent.")
  faqKnowledge Json?
}

model Call {
  id             String   @id @default(uuid())
  organizationId String   // Multi-tenant isolatie (alias voor tenantId)

  // Vapi Integration
  vapiCallId     String?  @unique // Externe Vapi call ID

  // Contact Info
  customerName   String?
  phoneNumber    String?
  email          String?

  // Call Data
  transcript     String?  @db.Text
  duration       Int?     // Gespreksduur in seconden
  summary        String?  @db.Text

  // Vapi Metadata & Function Results
  metadata       Json?    // Voor function call results, extractedData, etc.

  // AI Classification (Shield State)
  intent         CallIntent?   @default(LEAD)
  mode           CallMode?     @default(SALES)
  priority       CallPriority? @default(LOW)

  // Shield Mode Fields
  invoiceNumber  String?  // Shield Mode: Factuurnummer
  companyName    String?  // Shield Mode: Bedrijfsnaam (incasso, schuldeiser)
  appointment    Boolean  @default(false)

  // Compliance & Quality Control
  requiresReview Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  tenant         Tenant   @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([vapiCallId])
  @@index([createdAt])
  @@index([organizationId, intent, mode])
}

model FAQEmbedding {
  id        String   @id @default(uuid())
  tenantId  String
  question  String
  answer    String
  embedding Unsupported("vector(1536)")

  createdAt DateTime @default(now())

  @@index([tenantId])
}



