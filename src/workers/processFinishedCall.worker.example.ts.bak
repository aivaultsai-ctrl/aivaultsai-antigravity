/**
 * INTEGRATION EXAMPLE: processFinishedCall Worker met Shield Notification
 * 
 * Dit voorbeeld toont hoe je de AI prompts en notification service
 * integreert in je BullMQ worker voor voice call processing.
 */

import { Job } from 'bullmq';
import { prisma } from '../models/prisma';
import { logger } from '../config/logger';
import {
    SHIELD_SYSTEM_PROMPT,
    injectPromptVariables,
    detectShieldMode,
    ShieldInfoExtraction,
    LeadInfoExtraction
} from '../config/ai-prompts';
import {
    sendShieldNotification,
    sendLeadNotification
} from '../services/notification.service';

interface CallFinishedPayload {
    callId: string;
    tenantId: string;
    transcript: string;
    duration: number;
    fromNumber: string;
    timestamp: string;
    // Function call results from VAPI/Retell
    extractedData?: ShieldInfoExtraction | LeadInfoExtraction;
}

export async function processFinishedCall(job: Job<CallFinishedPayload>) {
    const { callId, tenantId, transcript, duration, fromNumber, extractedData } = job.data;

    logger.info({ callId, tenantId }, 'Processing finished call');

    try {
        // 1. Get tenant info
        const tenant = await prisma.tenant.findUnique({
            where: { id: tenantId },
            select: {
                id: true,
                name: true,
                notificationPhone: true,
                preferWhatsApp: true
            }
        });

        if (!tenant) {
            throw new Error(`Tenant ${tenantId} not found`);
        }

        // 2. Determine if this was a Shield Mode call
        const isShieldMode = extractedData
            ? extractedData.intent === 'FINANCIAL'
            : detectShieldMode(transcript);

        // 3. Save to database
        const lead = await prisma.lead.create({
            data: {
                tenantId: tenant.id,
                phoneNumber: fromNumber,

                // Shield Mode fields
                intent: extractedData?.intent || (isShieldMode ? 'FINANCIAL' : 'LEAD'),
                mode: isShieldMode ? 'DEFENSIVE' : 'SALES',
                priority: (extractedData as ShieldInfoExtraction)?.priority || 'MEDIUM',

                // Optional fields from extraction
                customerName: (extractedData as LeadInfoExtraction)?.customerName,
                email: (extractedData as LeadInfoExtraction)?.email,
                invoiceNumber: (extractedData as ShieldInfoExtraction)?.invoiceNumber,
                companyName: (extractedData as ShieldInfoExtraction)?.companyName,

                // Context
                summary: extractedData?.summary || 'Geen samenvatting beschikbaar',
                transcriptContent: transcript,
                callDurationSeconds: duration,

                // Metadata
                createdAt: new Date(job.data.timestamp),
                appointmentRequest: false,
                isFaq: extractedData?.intent === 'FAQ'
            }
        });

        logger.info({ leadId: lead.id, mode: lead.mode }, 'Lead saved to database');

        // 4. Send notifications
        if (isShieldMode && tenant.notificationPhone) {
            // 🛡️ SHIELD ALERT
            await sendShieldNotification({
                to: tenant.notificationPhone,
                tenantName: tenant.name,
                invoiceNumber: (extractedData as ShieldInfoExtraction)?.invoiceNumber,
                companyName: (extractedData as ShieldInfoExtraction)?.companyName,
                priority: (extractedData as ShieldInfoExtraction)?.priority || 'HIGH',
                summary: extractedData?.summary || transcript.slice(0, 200),
                callTimestamp: new Date(job.data.timestamp),
                preferWhatsApp: tenant.preferWhatsApp || false
            });
        } else if (extractedData?.intent === 'LEAD' && tenant.notificationPhone) {
            // 🎯 LEAD NOTIFICATION
            await sendLeadNotification({
                to: tenant.notificationPhone,
                tenantName: tenant.name,
                customerName: (extractedData as LeadInfoExtraction)?.customerName,
                summary: extractedData.summary,
                intent: 'LEAD'
            });
        }

        logger.info({ callId, leadId: lead.id }, 'Call processing completed successfully');

        return { success: true, leadId: lead.id };

    } catch (error) {
        logger.error({ error, callId, tenantId }, 'Failed to process finished call');
        throw error; // Let BullMQ handle retry logic
    }
}

/**
 * Example: How to generate the system prompt for a tenant
 */
export async function generateTenantPrompt(tenantId: string): Promise<string> {
    const tenant = await prisma.tenant.findUnique({
        where: { id: tenantId },
        select: {
            name: true,
            id: true
        }
    });

    if (!tenant) {
        throw new Error(`Tenant ${tenantId} not found`);
    }

    // Optional: Fetch FAQ context from database
    const faqs = await prisma.fAQ.findMany({
        where: { tenantId: tenant.id },
        take: 10,
        orderBy: { createdAt: 'desc' }
    });

    const faqContext = faqs.length > 0
        ? faqs.map(faq => `Q: ${faq.question}\nA: ${faq.answer}`).join('\n\n')
        : undefined;

    return injectPromptVariables(SHIELD_SYSTEM_PROMPT, {
        tenant_name: tenant.name,
        tenant_id: tenant.id,
        faq_context: faqContext
    });
}
